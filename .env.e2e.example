# Копия для локального прогона: cp .env.e2e.example .env.e2e и заполнить.
# Файл в .gitignore — секреты не коммитим.

# Тестовый аккаунт энтузиаста (сценарий входа и публикации дегустации).
# Создайте в dev-проекте Supabase отдельного пользователя для e2e;
# прод-аккаунты и чужие данные не используйте. Без этих кредов сценарии
# входа помечаются пропущенными — остальные работают.
E2E_ENTHUSIAST_EMAIL=
E2E_ENTHUSIAST_PASSWORD=

# Прогон против уже поднятого сервера (например npm run dev -- -p 3100),
# без production-сборки в webServer. Удобно для отладки.
# E2E_BASE_URL=http://localhost:3100

# Пилотные кабинеты (сценарий «Кабинет ростерии → Процесс»): включает
# DevRoleSwitcher в e2e-сборке. Локальный dev-сервер читает .env.local —
# при прогоне через E2E_BASE_URL задавайте флаг там.
# NEXT_PUBLIC_PILOT_DEMO_ENABLED=true
