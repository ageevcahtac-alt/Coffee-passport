# Copy to .env.local and fill in — see README.md's "Environment variables"
# section for what each group is for.

# Supabase — get these from Project Settings > API after creating the project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# /admin — HTTP Basic Auth in front of the legacy partner-requests CRM
# (see middleware.ts). Pick your own values.
ADMIN_USER=
ADMIN_PASSWORD=

# DevRoleSwitcher's "sign in as pilot staff" buttons (Кофейня/Обжарщик/
# Бариста/Фидбек) — set to "true" only while this deployment is still a
# pilot demo with no real staff accounts. Unset/false disables the
# buttons and the server action behind them; the DB-level RPC also has
# its own kill switch (public.app_settings, 0029_pilot_demo_kill_switch.sql).
NEXT_PUBLIC_PILOT_DEMO_ENABLED=

# Partner-lead email notification (app/api/partner-requests) — optional.
# Without these two, the lead is still saved, just no email goes out.
RESEND_API_KEY=
PARTNER_NOTIFY_EMAIL=
# Optional: defaults to onboarding@resend.dev (Resend's shared sandbox
# sender) if unset — replace once you verify your own sending domain.
PARTNER_NOTIFY_FROM=

# Events cron (app/api/cron/events-archive, events-aggregate) — required
# for those two routes to accept requests at all; see .github/workflows/events-cron.yml,
# which must be given the same value as a repo secret.
EVENTS_CRON_SECRET=
# Optional: comma-separated .ics calendar feed URLs for the aggregator
# (see lib/events/sources). Empty = no external sources configured yet,
# the aggregate route just reports 0 candidates.
EVENT_SOURCE_ICS_URLS=

# XO Store read-only integration boundary (app/api/integrations/xo-store/lots,
# P23) — server-to-server bearer secret XO COFFEE Store's backend must send
# as `Authorization: Bearer <value>`. Unset = every request is rejected
# (fail-closed, same convention as EVENTS_CRON_SECRET above). Never expose
# this value to a browser bundle on either side.
XO_STORE_INTEGRATION_SECRET=

# XO COFFEE Admin — coffee-shop orders to the roastery + roastery production
# (lib/integrations/xoAdmin.ts). SERVER-ONLY, never NEXT_PUBLIC_. URL is the
# Admin app's base URL; the secret must equal Admin's PASSPORT_INTEGRATION_SECRET.
# Unset = the "Заказы в ростерию" / "Производство" screens show
# "XO COFFEE временно недоступен" (fail-closed).
XO_ADMIN_INTEGRATION_URL=
XO_ADMIN_INTEGRATION_SECRET=
