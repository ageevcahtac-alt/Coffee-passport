# Copy to .env.local and fill in — see README.md's "Environment variables"
# section for what each group is for.

# Supabase — get these from Project Settings > API after creating the project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# /admin — HTTP Basic Auth in front of the legacy partner-requests CRM
# (see middleware.ts). Pick your own values.
ADMIN_USER=
ADMIN_PASSWORD=

# Partner-lead email notification (app/api/partner-requests) — optional.
# Without these two, the lead is still saved, just no email goes out.
RESEND_API_KEY=
PARTNER_NOTIFY_EMAIL=
# Optional: defaults to onboarding@resend.dev (Resend's shared sandbox
# sender) if unset — replace once you verify your own sending domain.
PARTNER_NOTIFY_FROM=

# Events cron (app/api/cron/events-archive, events-aggregate) — required
# for those two routes to accept requests at all; see .github/workflows/events-cron.yml,
# which must be given the same value as a repo secret.
EVENTS_CRON_SECRET=
# Optional: comma-separated .ics calendar feed URLs for the aggregator
# (see lib/events/sources). Empty = no external sources configured yet,
# the aggregate route just reports 0 candidates.
EVENT_SOURCE_ICS_URLS=
